{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "mcp__Supabase",
      "mcp__github",
      "mcp__Lovable",
      "Bash"
    ],
    "deny": [
      "mcp__Supabase__pause_project",
      "mcp__Supabase__restore_project",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__reset_branch",
      "mcp__github__delete_file",
      "mcp__Lovable__delete_workspace_skill",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -D:*)",
      "Bash(git clean:*)",
      "Read(./.env*)"
    ]
  }
}
